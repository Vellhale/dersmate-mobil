# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env AYRICA yazılmalı: .env*.local kalıbı düz `.env` dosyasını KAPSAMAZ ve
# EXPO_PUBLIC_API_URL gibi ortama özel adresler oraya yazılıyor (bkz. .env.example).
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Play Console servis hesabı anahtarı (eas.json → submit.production).
# Bu dosya mağaza hesabına yükleme yetkisi taşır; depoya ASLA girmemeli.
play-service-account.json
*-service-account.json

# FCM V1 hizmet hesabı anahtarı (push bildirimleri). Firebase konsolunun verdiği
# varsayılan ad `<proje>-firebase-adminsdk-<kimlik>.json` ve yukarıdaki
# *-service-account.json kalıbına UYMUYOR — ayrı kural olmasa herkese açık depoya
# sızabilirdi. Bu dosya `eas credentials` ile EAS'e yüklenir, depoda hiç durmaz.
# ⚠️ google-services.json BURADA DEĞİL ve olmamalı: gizli değil, EAS derlemesine gitmesi
# gerekiyor (app.config.js → googleServicesFile).
*-firebase-adminsdk-*.json

# Playwright MCP oturum çıktıları
# Tarayıcı oturumlarının ekran görüntüleri ve konsol dökümleri — her koşuda yeniden
# üretiliyor, depoda tutulacak bir şey değil. Bu kural olmadan tek bir `git add -A`
# 67 dosya / 343 KB gürültü ekliyordu. Ana depoda aynı kural zaten var.
.playwright-mcp/
